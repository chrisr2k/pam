# Domain (set this to your public domain, e.g. azurepam.com)
PAM_DOMAIN=localhost

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev,.ngrok.io
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://*.ngrok-free.dev,https://*.ngrok.io

# External URL (set this when using ngrok or a reverse proxy)
# EXTERNAL_URL=https://your-ngrok-url.ngrok-free.dev

# Database (SQLite for local dev)
# DATABASE_URL=postgres://pam:pam_password@db:5432/pam

# Redis (not needed for local dev without Celery)
# REDIS_URL=redis://redis:6379/0

# ── Entra ID OIDC (for user login) ──────────────────────────────────────
# Create an App Registration in Entra ID with:
#   - Redirect URI: http://localhost:8080/accounts/callback/
#   - ID tokens: enabled
#   - API Permissions: User.Read (delegated)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ── Entra ID PIM (for role management - SEPARATE app) ───────────────────
# For production, create a SECOND App Registration with:
#   - API Permissions: RoleManagement.ReadWrite.Directory (application)
#   - Authentication: Managed Identity (Azure) or certificate (OCI/on-prem)
#
# If not set, falls back to the OIDC app credentials (dev only).
# ENTRA_PIM_TENANT_ID=
# ENTRA_PIM_CLIENT_ID=
# ENTRA_PIM_CLIENT_SECRET=

# Certificate-based auth for PIM (alternative to client secret)
# ENTRA_PIM_CERTIFICATE_PATH=/path/to/cert.pfx
# ENTRA_PIM_CERTIFICATE_PASSWORD=your-cert-password
# ENTRA_PIM_CERTIFICATE_B64=<base64-encoded-cert-data>

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SSO_INSTANCE_ARN=

# ── Multi-Cloud Secrets Resolver ──────────────────────────────────────────
# The app auto-detects the cloud environment. Override with:
# PAM_SECRETS_BACKEND=azure|aws|gcp|oci|local
#
# Azure Key Vault (when running on Azure with Managed Identity):
# AZURE_KEY_VAULT_URL=https://pam-kv-prod.vault.azure.net/
#
# GCP Secret Manager (when running on GCP with Workload Identity):
# GOOGLE_CLOUD_PROJECT=my-project-id
#
# OCI Vault (when running on OCI with instance principal):
# OCI_VAULT_OCID=ocid1.vault.oc1...

# PAM Settings
PAM_DEFAULT_MAX_HOURS=8
PAM_NOTIFICATION_EMAIL_FROM=noreply@pam.local
PAM_BASE_URL=http://localhost:8080
