aws_region        = "us-east-1"
vpc_id            = "vpc-xxxxxxxx"
public_subnet_ids = ["subnet-xxxx1", "subnet-xxxx2"]
private_subnet_ids = ["subnet-xxxx3", "subnet-xxxx4"]
